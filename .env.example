# App branding (public)
NEXT_PUBLIC_APP_NAME=Noor

# Quran Foundation Content API credentials (server-only, request at https://api-docs.quran.com/)
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# Optional overrides. Defaults are the production endpoints.
# Pre-production credentials use the prelive hosts:
# QURAN_OAUTH_URL=https://prelive-oauth2.quran.foundation
# QURAN_API_BASE=https://apis-prelive.quran.foundation/content/api/v4
QURAN_OAUTH_URL=
QURAN_API_BASE=

# Development only: read from the public api.quran.com endpoint without credentials.
# Check the provider's terms before using this beyond local development.
QURAN_ALLOW_PUBLIC_API=false

# ---- Accounts (Supabase). See SETUP.md ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of your site (used for sitemap and sign-in links), e.g. https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=
# SERVER ONLY. Never expose. Needed only for the "Delete account" feature.
SUPABASE_SERVICE_ROLE_KEY=
